# Dockhand stack env for compose.homelab.yaml (copy the values from plexnuc ~/firecrawl/.env)
PORT=3002
HOST=0.0.0.0
USE_DB_AUTHENTICATION=false
BULL_AUTH_KEY=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Must stay `postgres`: nuq-postgres creates the pg_cron extension, which only
# works in a database literally named postgres (a custom name exits 3 on init).
POSTGRES_DB=postgres
LOGGING_LEVEL=INFO
